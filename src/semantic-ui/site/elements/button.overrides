/*******************************
         Site Overrides
*******************************/

/* PatientInfo brand colors for toggle buttons */
.ui.toggle.buttons .button.active,
.ui.toggle.button.active {
  background: #4768fd !important;
  color: #fff !important;
  border-color: #4768fd !important;
}

/* Focus and active states using brand colors */
.ui.buttons .button:active,
.ui.button:active,
.ui.buttons .button:focus,
.ui.button:focus {
  background: #f6f8ff !important;
  color: #32325d !important;
  border-color: #4768fd !important;
  box-shadow: 0 0 0 4px #151527 !important;
}

/* Hover styling for preset radio button group - PatientInfo brand colors */
.ui.basic.buttons.preset-buttons .button:not(.disabled):not([disabled]):hover,
.ui.buttons.preset-buttons .button:not(.disabled):not([disabled]):hover,
.ui.basic.button.preset-buttons:not(.disabled):not([disabled]):hover,
.preset-buttons .button:not(.disabled):not([disabled]):hover {
  background: #4768fd !important;
  color: #fff !important;
  border-color: #4768fd !important;
  box-shadow: none !important;
}

/* Disabled state: grey out and remove interactions/hover for preset buttons */
.preset-buttons .button.disabled,
.preset-buttons .button:disabled,
.ui.buttons.preset-buttons .button.disabled,
.ui.buttons.preset-buttons .button:disabled,
.ui.basic.buttons.preset-buttons .button.disabled,
.ui.basic.buttons.preset-buttons .button:disabled,
.ui.basic.button.preset-buttons.disabled,
.ui.basic.button.preset-buttons:disabled {
  background: #f8f8f9 !important;
  color: #6f6f8c !important;
  border-color: #dedee2 !important;
  box-shadow: none !important;
  cursor: not-allowed !important;
  opacity: 0.45 !important;
  pointer-events: none !important; /* ensure no hover */
}

/* Defensive: ensure no hover styles apply when disabled */
.preset-buttons .button.disabled:hover,
.preset-buttons .button:disabled:hover,
.ui.basic.buttons.preset-buttons .button.disabled:hover,
.ui.basic.buttons.preset-buttons .button:disabled:hover,
.ui.basic.button.preset-buttons.disabled:hover,
.ui.basic.button.preset-buttons:disabled:hover {
  background: #f8f8f9 !important;
  color: #6f6f8c !important;
  border-color: #dedee2 !important;
  box-shadow: none !important;
}