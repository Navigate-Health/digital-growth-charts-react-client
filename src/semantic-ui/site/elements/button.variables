/*******************************
    User Variable Overrides
*******************************/

/* PatientInfo Brand Button Colors */
@primaryColor: #1e2c6a;
@positiveColor: #1e2c6a;

/* Focus effects - PatientInfo style */
@focusBoxShadow: 0 0 0 4px #151527;
@invertedFocusBoxShadow: 0 0 0 4px #151527;

/* Toggle (radio-like) buttons: active state using brand colors */
@toggleOnBackgroundColor: #1e2c6a;
@toggleOnTextColor: #fff;
@toggleOnBorderColor: #1e2c6a;

/* Pressed/clicked (:active) state for non-active buttons */
@downBackgroundColor: #f6f8ff;
@downTextColor: #32325d;
@downBorderColor: #1e2c6a;