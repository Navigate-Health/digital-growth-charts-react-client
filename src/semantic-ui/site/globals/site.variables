/*******************************
     User Global Variables
*******************************/
/* Use Vite base for all fonts served from public/fonts */
@fontPath   : '@{basePath}fonts';

/* Ensure icon CSS emits <base>/fonts/... URLs */
@iconFontPath        : '@{basePath}fonts';
@outlineIconFontPath : '@{basePath}fonts';
@brandFontPath       : '@{basePath}fonts';

/* Fonts */
@fontName: 'Poppins';
@importGoogleFonts: false;

@defaultBorderRadius: 12px;

/* PatientInfo Brand Colours */
/* Primary Colors */
@primaryAccentBlue: #4768fd;
@darkText: #32325d;
@veryDark: #151527;
@sectionPurple: #503eae;

/* Gray Scale */
@mediumGray: #6f6f8c;
@borderGray: #b8b8bf;
@lightBorder: #dedee2;
@veryLightBg: #f8f8f9;
@lightBlueBg: #f6f8ff;

/* RCPCH Colour Variables - Updated to PatientInfo branding */
@rcpch-nav-actv: #4768fd;
@rcpch-nav: #4768fd;
@rcpch-dark-blue-header: #32325d;

@blue: #4768fd;
@pink: #e00087;